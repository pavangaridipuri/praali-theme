{%- comment -%}
  Letters from Praali: blog listing in the new design.
  Shows a heading + subtitle, then every post of the current blog as a card
  with the title and a "Read more" button on top of the photo.
  Used on: templates/blog.letters.json
{%- endcomment -%}

{%- paginate blog.articles by 12 -%}
  <section class="letters">
    <div class="container">
      <div class="letters__intro">
        <h1 class="letters__heading">{{ section.settings.heading | default: blog.title }}</h1>
        {%- if section.settings.subtitle != blank -%}
          <div class="letters__subtitle">{{ section.settings.subtitle }}</div>
        {%- endif -%}
      </div>

      {%- if blog.articles.size == 0 -%}
        <p class="letters__empty">No letters yet. Check back soon.</p>
      {%- else -%}
        <div class="letters__grid">
          {%- for article in blog.articles -%}
            <a class="letter-card" href="{{ article.url }}">
              {%- if article.image -%}
                {{
                  article.image
                  | image_url: width: 900
                  | image_tag:
                    class: 'letter-card__image',
                    loading: 'lazy',
                    widths: '400, 600, 900',
                    sizes: '(min-width: 750px) 33vw, 100vw',
                    alt: article.title
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'letter-card__image letter-card__placeholder' }}
              {%- endif -%}

              <span class="letter-card__overlay">
                <span class="letter-card__title">{{ article.title }}</span>
                <span class="letter-card__button">{{ section.settings.button_label }}</span>
              </span>
            </a>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="letters__pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}">← Newer</a>
            {%- endif -%}
            <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}">Older →</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% stylesheet %}
  .letters {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    padding: 56px 0 80px;
  }

  .letters__intro {
    margin-bottom: 40px;
  }

  .letters__heading {
    font-family: inherit;
    font-weight: 300;
    font-size: 22px;
    letter-spacing: 0.12em;
    margin-bottom: 12px;
  }

  .letters__subtitle {
    font-size: 12px;
    line-height: 1.7;
    letter-spacing: 0.05em;
    max-width: 420px;
  }

  .letters__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .letter-card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    background: var(--line);
  }

  .letter-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .letter-card:hover .letter-card__image {
    transform: scale(1.03);
  }

  /* Darkens the top and bottom slightly so the white text stays readable */
  .letter-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: 24px 16px;
    text-align: center;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(0, 0, 0, 0) 35%,
      rgba(0, 0, 0, 0) 70%,
      rgba(0, 0, 0, 0.25) 100%
    );
  }

  .letter-card__title {
    font-size: 13px;
    letter-spacing: 0.08em;
    line-height: 1.4;
    max-width: 85%;
  }

  .letter-card__button {
    padding: 8px 20px;
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .letters__pagination {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin-top: 40px;
    font-size: 13px;
  }

  .letters__pagination a {
    color: inherit;
  }

  @media (max-width: 749px) {
    .letters__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Letters list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Love Letters From Praali",
      "info": "Leave empty to use the blog's own title"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Everything at Praali comes from love. Discover the thought behind it.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read more"
    }
  ]
}
{% endschema %}
