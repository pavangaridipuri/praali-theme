{%- comment -%}
  Our Practices: heading + one image, then a list of practices.
  Used on: About Us.
  Each "Practice" block = a short title + a description.
{%- endcomment -%}

<section
  class="practices"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;{% if section.settings.background != blank %} background: {{ section.settings.background }};{% endif %}"
>
  <div class="container">
    <div class="practices__top">
      {%- if section.settings.heading != blank -%}
        <h2 class="practices__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="practices__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000',
              sizes: '(min-width: 750px) 40vw, 100vw'
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'practices__placeholder' }}
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="practices__list">
        {%- for block in section.blocks -%}
          <li class="practices__item" {{ block.shopify_attributes }}>
            <h3 class="practices__title">{{ block.settings.title }}</h3>
            <div class="practices__text">{{ block.settings.text }}</div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .practices {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .practices__top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
    margin-bottom: 56px;
  }

  .practices__heading {
    font-family: inherit;
    font-weight: 300;
    font-size: 14px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .practices__media img,
  .practices__placeholder {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--line);
  }

  .practices__list {
    list-style: none;
    max-width: 640px;
  }

  .practices__item {
    position: relative;
    padding-left: 20px;
    margin-bottom: 28px;
  }

  .practices__item:last-child {
    margin-bottom: 0;
  }

  /* Small marker before each practice, like the design */
  .practices__item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 7px;
    height: 7px;
    border: 1px solid currentColor;
    border-radius: 50%;
  }

  .practices__title {
    font-family: inherit;
    font-weight: 400;
    font-size: 15px;
    margin-bottom: 6px;
  }

  .practices__text {
    font-size: 13px;
    line-height: 1.7;
  }

  .practices__text p + p {
    margin-top: 0.8em;
  }

  @media (max-width: 749px) {
    .practices__top {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 36px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Our practices",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Practices"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background color (optional)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "practice",
      "name": "Practice",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Practice title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Placeholder text. Replace this with the copy from the design.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our practices",
      "blocks": [
        { "type": "practice" },
        { "type": "practice" },
        { "type": "practice" },
        { "type": "practice" }
      ]
    }
  ]
}
{% endschema %}
